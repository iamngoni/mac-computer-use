{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mac-computer-use-site",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/download", "/download/*", "/api/*"],
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "mcu.iamngoni.dev", "custom_domain": true }],
  "observability": { "enabled": true }
}
